# Environment variables - copy to .env and fill in your values

# Server
PORT=3000
HOST=0.0.0.0
DEV_BIND_LOCALHOST=false

# Comma-separated list of allowed CORS origins.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:8081,https://app.example.com
# In development, if empty, all origins are temporarily allowed.
CORS_ALLOWED_ORIGINS=

# Security Controls
TRUST_PROXY=true
ENFORCE_HTTPS=true
ALLOW_PUBLIC_CONFIG=false

# Auth hardening
AUTH_REQUIRE_EMAIL_VERIFIED=true
AUTH_MAX_SESSION_AGE_SECONDS=86400

# RBAC Bootstrap Secret (used for initial super admin setup via /api/v1/bootstrap/*)
BOOTSTRAP_SECRET=your-strong-random-secret-here

# Abuse protection
AUTH_LIMIT_WINDOW_MS=900000
AUTH_LIMIT_MAX=20
API_LIMIT_WINDOW_MS=60000
API_LIMIT_MAX=120
WRITE_LIMIT_WINDOW_MS=60000
WRITE_LIMIT_MAX=30

# PostgreSQL / Supabase Postgres
# Supabase-first recommendation:
# - DATABASE_URL: use the pooled transaction connection string for app traffic
# - DIRECT_URL: use the session/direct connection string for Prisma migrations
# Local development can still point these at localhost, but production should
# target your Supabase Postgres instance.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:pdtsupabase@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:pdtsupabase@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Legacy alias still supported by the backend config:
DIRECT_DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:pdtsupabase@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Email OTP delivery (Gmail SMTP recommended)
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=
OTP_FROM_NAME="PDT Admin"
EMAIL_OTP_EXPIRES_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5

# File Storage
# Set to `supabase` once you have created the buckets and migrated local files.
STORAGE_PROVIDER=supabase
STORAGE_SIGNED_URL_EXPIRES_SECONDS=3600

# Local disk path for uploaded files when STORAGE_PROVIDER=local
UPLOADS_DIR=./uploads

# Supabase Storage settings when STORAGE_PROVIDER=supabase
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_RECORDS_BUCKET=health-records
SUPABASE_STORAGE_PROFILE_BUCKET=profile-pictures
