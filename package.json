{
  "name": "pdt-backend",
  "version": "1.0.0",
  "description": "PDT Fitness App - Node.js/Express backend with Prisma ORM and Supabase Postgres",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:verify": "node .\\scripts\\verify-database.js",
    "supabase:preflight": "node .\\scripts\\supabase-preflight.js",
    "supabase:migrate:storage": "node .\\scripts\\migrate-storage-to-supabase.js --apply",
    "supabase:migrate:storage:dry": "node .\\scripts\\migrate-storage-to-supabase.js --dry-run",
    "env:local": ".\\scripts\\switch-env.bat local",
    "env:cloud": ".\\scripts\\switch-env.bat cloud"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0"
  }
}
